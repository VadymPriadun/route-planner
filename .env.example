# PostgreSQL / PostGIS
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel_dev_password
POSTGRES_DB=travel_explorer
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Prisma (порт має збігатися з POSTGRES_PORT)
DATABASE_URL="postgresql://travel:travel_dev_password@localhost:5433/travel_explorer?schema=public"

# API
JWT_SECRET=replace_with_random_string_min_32_chars
JWT_EXPIRES_IN_SECONDS=86400
API_PORT=4000
CORS_ORIGIN=http://localhost:3000